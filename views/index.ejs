<%
  // Incluir cabecera directamente sin layout separado
  const pageTitle = titulo;
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %> | ProyectoGit</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="/css/estilos.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

  <%- include('partials/navbar') %>

  <main class="container my-4 flex-grow-1">
    <div class="text-center py-5">
      <i class="bi bi-box-seam display-1 text-primary"></i>
      <h1 class="fw-bold mt-3">Bienvenido a ProyectoGit</h1>
      <p class="lead text-muted">Sistema de gestión de productos con lector de códigos de barra</p>
      <div class="d-flex justify-content-center gap-3 mt-4">
        <a href="/scanner" class="btn btn-primary btn-lg">
          <i class="bi bi-upc-scan me-2"></i>Ir al Scanner
        </a>
        <a href="/inventario" class="btn btn-outline-secondary btn-lg">
          <i class="bi bi-archive me-2"></i>Ver Inventario
        </a>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
