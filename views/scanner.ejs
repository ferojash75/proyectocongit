<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= titulo %> | ProyectoGit</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="/css/estilos.css" rel="stylesheet" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

  <%- include('partials/navbar') %>

  <main class="container my-4 flex-grow-1">
    <div class="row justify-content-center">
      <div class="col-lg-8">

        <!-- Título -->
        <div class="d-flex align-items-center mb-4">
          <i class="bi bi-upc-scan fs-2 text-primary me-3"></i>
          <div>
            <h2 class="mb-0 fw-bold">Scanner de Códigos de Barra</h2>
            <p class="text-muted mb-0 small">Escanea un producto o escribe el código manualmente</p>
          </div>
        </div>

        <!-- Panel de escaneo -->
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-body p-4">

            <!-- Estado del scanner -->
            <div id="scanner-status" class="alert alert-info d-flex align-items-center mb-3" role="alert">
              <i class="bi bi-info-circle-fill me-2"></i>
              <span>Listo para escanear. Conecta tu lector o escribe el código abajo.</span>
            </div>

            <!-- Input del código de barra -->
            <div class="input-group input-group-lg mb-3">
              <span class="input-group-text bg-white border-end-0">
                <i class="bi bi-upc text-primary"></i>
              </span>
              <input
                type="text"
                id="barcode-input"
                class="form-control border-start-0 ps-0"
                placeholder="Escanea o escribe el código de barra..."
                autocomplete="off"
                autofocus
                aria-label="Código de barra"
              />
              <button class="btn btn-primary px-4" id="btn-buscar" type="button">
                <i class="bi bi-search me-1"></i>Buscar
              </button>
              <button class="btn btn-outline-secondary" id="btn-limpiar" type="button" title="Limpiar">
                <i class="bi bi-x-lg"></i>
              </button>
            </div>

            <!-- Indicador de carga -->
            <div id="loader" class="text-center d-none py-2">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Buscando...</span>
              </div>
              <p class="text-muted mt-2 mb-0 small">Buscando producto...</p>
            </div>

          </div>
        </div>

        <!-- Resultado del producto encontrado -->
        <div id="resultado-producto" class="d-none">
          <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-success text-white d-flex align-items-center">
              <i class="bi bi-check-circle-fill me-2"></i>
              <span class="fw-semibold">Producto encontrado</span>
            </div>
            <div class="card-body p-4">
              <div class="row align-items-center">
                <div class="col-sm-8">
                  <h4 id="prod-nombre" class="fw-bold mb-1">—</h4>
                  <p id="prod-descripcion" class="text-muted mb-2 small">—</p>
                  <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-secondary" id="prod-categoria"></span>
                    <span class="badge bg-light text-dark border">
                      <i class="bi bi-upc me-1"></i><span id="prod-barcode"></span>
                    </span>
                  </div>
                </div>
                <div class="col-sm-4 text-sm-end mt-3 mt-sm-0">
                  <p class="fs-4 fw-bold text-success mb-1" id="prod-precio">$0.00</p>
                  <p class="text-muted small mb-0">
                    Stock: <span id="prod-stock" class="fw-semibold">0</span> unidades
                  </p>
                </div>
              </div>

              <!-- Selector de cantidad y botón agregar -->
              <hr />
              <div class="d-flex align-items-center gap-3 flex-wrap">
                <label for="cantidad-input" class="fw-semibold mb-0">Cantidad:</label>
                <div class="input-group" style="width: 140px;">
                  <button class="btn btn-outline-secondary" type="button" id="btn-menos">
                    <i class="bi bi-dash"></i>
                  </button>
                  <input type="number" id="cantidad-input" class="form-control text-center" value="1" min="1" />
                  <button class="btn btn-outline-secondary" type="button" id="btn-mas">
                    <i class="bi bi-plus"></i>
                  </button>
                </div>
                <button class="btn btn-success" id="btn-agregar-carrito" type="button">
                  <i class="bi bi-cart-plus me-2"></i>Agregar al carrito
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Mensaje de error / no encontrado -->
        <div id="resultado-error" class="d-none">
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>
              <strong>Producto no encontrado.</strong>
              <span id="error-codigo" class="ms-1 text-muted small"></span>
            </div>
          </div>
        </div>

        <!-- Carrito de la sesión -->
        <div id="seccion-carrito" class="d-none">
          <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
              <span class="fw-semibold"><i class="bi bi-cart3 me-2 text-primary"></i>Carrito de venta</span>
              <button class="btn btn-sm btn-outline-danger" id="btn-vaciar-carrito">
                <i class="bi bi-trash me-1"></i>Vaciar
              </button>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Producto</th>
                      <th class="text-center">Cant.</th>
                      <th class="text-end">P. Unit.</th>
                      <th class="text-end">Subtotal</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody id="carrito-items">
                    <!-- Filas generadas dinámicamente -->
                  </tbody>
                </table>
              </div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
              <span class="fw-bold fs-5">Total:</span>
              <span class="fw-bold fs-5 text-success" id="carrito-total">$0.00</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/barcode.js"></script>
</body>
</html>
